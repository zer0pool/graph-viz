server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Support for Iframe embedding (for Shell usage)
    add_header Content-Security-Policy "frame-ancestors 'self' http://localhost:5100 http://localhost:5000;" always;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Support for Standalone Access at Subpath
    location $BASE_URL/ {
        rewrite ^$BASE_URL/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    # API Proxying
    location ~ ^($BASE_URL)?/api {
        resolver $NAMESERVER valid=30s;
        set $upstream http://app-manager:5003;
        
        rewrite ^($BASE_URL)?/api/(.*)$ /lineage-manager/api/$2 break;
        proxy_pass $upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Disable caching for Module Federation configs
    location ~* (remoteEntry\.js|config\.js)$ {
        rewrite ^$BASE_URL/(.*)$ /$1 break;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # Handle Static Assets
    # Use regex that supports optional BASE_URL prefix
    location ~* \.(js|css|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        rewrite ^$BASE_URL/(.*)$ /$1 break;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

server {
    listen 80;
    server_name localhost;

    # 1. Base root directory
    root /usr/share/nginx/html;
    index index.html;

    # 2. Access logs to stdout/stderr for K8s observability
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # 3. Handle Static Assets at Subpath
    # This block allows assets like /lineage-manager/bundle.js to be served
    # from the root of /usr/share/nginx/html while preserving the URL.
    location ${BASE_URL}/ {
        # Force trailing slash for consistency if accessed without it
        # (handhandled by the = ${BASE_URL} block below)
        
        # Rewrite subpath prefix away for internal file lookup
        # e.g. /lineage-manager/config.js -> /config.js
        rewrite ^${BASE_URL}/(.*)$ /$1 break;
        
        # Try finding the file. If not found, serve index.html for SPA routing.
        try_files $uri $uri/ /index.html;
    }

    # 4. Redirect root to BASE_URL (Landing page)
    location = / {
        return 301 ${BASE_URL}/;
    }

    # 5. Redirect exact base path (without slash) to trailing slash
    location = ${BASE_URL} {
        return 301 ${BASE_URL}/;
    }

    # 6. API Proxying (Handles both relative and absolute paths)
    location ~ ^(${BASE_URL})?/api {
        # Use a resolver to allow runtime resolution of upstream hosts.
        # This prevents Nginx from crashing if the 'lineage-manager' host 
        # is not resolvable at startup (common in K8S).
        resolver ${NAMESERVER} valid=30s;
        
        # Use a variable for the proxy_pass target to force runtime resolution.
        set $upstream http://lineage-manager:5003;
        
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA routing fallback for any other path starting with BASE_URL
    # (Redundant due to try_files in location block, but safer)
    error_page 404 /index.html;

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

server {
    listen 80;
    server_name localhost;

    # 1. Base root directory
    root /usr/share/nginx/html;
    index index.html;

    # 2. Access logs to stdout/stderr for K8s observability
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # 3. Handle Static Assets at Subpath
    # BASE_URL_PREFIX is empty for root (/), or e.g. '/lineage-manager'
    location $BASE_URL_PREFIX/ {
        # Rewrite subpath prefix away for internal file lookup
        rewrite ^$BASE_URL_PREFIX/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    # 4. Landing Page Logic
    location = / {
        $REDIRECT_COMMAND
        try_files $uri /index.html;
    }

    # 5. Subpath Redirect Block (e.g. /admin -> /admin/)
    $SUBPATH_REDIRECT_BLOCK

    # 6. API Proxying
    location ~ $API_LOCATION_REGEX {
        resolver $NAMESERVER valid=30s;
        set $upstream http://lineage-manager:5003;
        
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA routing fallback for any other path starting with BASE_URL
    # (Redundant due to try_files in location block, but safer)
    error_page 404 /index.html;

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

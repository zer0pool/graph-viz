map $http_user_agent $loggable {
    ~*GoogleHC    0;
    ~*kube-probe  0;
    default       1;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;
    absolute_redirect off;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 1. Base root directory
    root /usr/share/nginx/html;
    index index.html;

    # 2. Access logs: stdout for K8s logs, and a REAL file for internal tail -f debugging
    access_log /dev/stdout combined if=$loggable;
    access_log /tmp/shell_access.log combined if=$loggable; # /var/log/nginx와 겹치지 않는 진짜 파일
    error_log /dev/stderr warn;

    # Support for Iframe embedding (for Shell usage)
    add_header Content-Security-Policy "frame-ancestors 'self' http://localhost:5100 http://localhost:5000;" always;

    # 6. MFE Proxying (Kubernetes only - routes to internal MFE services)
    # PLACED HERE TO TAKE PRECEDENCE OVER ANY REGEX MATCHERS
    location ^~ $BASE_URL_PREFIX/mfe-lineage/ {     
                
        rewrite ^$BASE_URL_PREFIX/mfe-lineage/(.*)$ /$1 break;
        
        proxy_pass $MFE_LINEAGE_UPSTREAM;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # Debug logs
        access_log /var/log/nginx/mfe_access.log;
        error_log /var/log/nginx/mfe_error.log debug;
    }

    location ^~ $BASE_URL_PREFIX/mfe-catalog/ {
                
        rewrite ^$BASE_URL_PREFIX/mfe-catalog/(.*)$ /$1 break;
        
        proxy_pass $MFE_CATALOG_UPSTREAM;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # Debug logs
        access_log /var/log/nginx/mfe_access.log;
        error_log /var/log/nginx/mfe_error.log debug;
    }

    # 2.1 Disable caching for Module Federation configs
    location ~* (remoteEntry\.js|config\.js)$ {
        rewrite ^$BASE_URL_PREFIX/(.*)$ /$1 break;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # 3. Handle Static Assets at Subpath
    location ~* $BASE_URL_PREFIX/(.*)\.(js|css|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        rewrite ^$BASE_URL_PREFIX/(.*)$ /$1 break;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    location $BASE_URL_PREFIX/ {
        # Satisfy GCP/GKE Health Checkers which expect 200 OK on the subpath
        if ($loggable = 0) {
            access_log off;
            return 200 "healthy";
        }
        # Rewrite subpath prefix away for internal file lookup
        rewrite ^$BASE_URL_PREFIX/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    # 4. Landing Page & Health Check Logic
    location = / {
        # Satisfy GCP/GKE Health Checkers which expect 200 OK
        if ($loggable = 0) {
            access_log off;
            return 200 "healthy";
        }
        $REDIRECT_COMMAND
        try_files $uri /index.html;
    }

    # Dedicated Health Check endpoints
    location ~ ^/(healthz|health|healthcheck)$ {
        access_log off;
        return 200 "OK";
    }

    # 5. Subpath Redirect Block (e.g. /admin -> /admin/)
    $SUBPATH_REDIRECT_BLOCK

    # 6. OIDC Callback Proxying
    location = $BASE_URL_PREFIX/authorized {
        # add detailed logging for debugging 
        access_log /var/log/nginx/oidc_access.log;
        error_log /var/log/nginx/oidc_error.log;

        # Proxy to baxkend /api/v1/auth/authorized
        proxy_pass $BACKEND_HOST/api/v1/auth/authorized;
        
        # Forward the original Host (e.g., self-scheduling.com) not the K8S service name
        # This ensures backend redirects use the correct external domain
        proxy_set_header Host $http_host;
        
        # Forward the original protocol (HTTPS) from the Ingress
        # This prevents Mixed Content errors and ensures OIDC redirects are HTTPS
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        
        # Standard forwarding headers
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Forward cookies for session management
        proxy_cookie_domain off;
        proxy_cookie_path off;
    }
    
    # 7. API Proxying
    location ~ ^(/admin-console)?/api {
        # Add detailed logging for debugging        
        access_log /var/log/nginx/api_access.log;
        error_log /var/log/nginx/api_error.log;

        # Strip the prefix if it exists and ADD the backend root_path
        rewrite ^($BASE_URL_PREFIX)?/api/(.*)$ /api/$2 break;

        # Log after rewrite
        rewrite_log on;        

        proxy_pass $BACKEND_HOST;

        # Forward the original Host (e.g., self-scheduling.com) not the K8S service name
        # This ensures backend redirects use the correct external domain
        proxy_set_header Host $http_host;
        
        # Forward the original protocol (HTTPS) from the Ingress
        # This prevents Mixed Content errors and ensures OIDC redirects are HTTPS
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        
        # Standard forwarding headers
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA routing fallback for any other path starting with BASE_URL
    # (Redundant due to try_files in location block, but safer)
    # error_page 404 /index.html;

}

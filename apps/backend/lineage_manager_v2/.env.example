# Lineage Manager V2 Configuration Example
# Copy this file to .env and modify as needed.

# Project Settings
PROJECT_NAME="Lineage Manager V2"
API_V2_STR="/api/v2"

# Database Configuration (MySQL Async)
# DB_HOST: The hostname or IP address of the MySQL server
DB_HOST=127.0.0.1
# DB_PORT: The port number of the MySQL server (default: 33306 for the project's docker setup)
DB_PORT=33306
# DB_USER: Database username
DB_USER=root
# DB_PASSWORD: Database password
DB_PASSWORD=root123
# DB_NAME: The name of the database to use
DB_NAME=lineage_manager_v2

# Redis Configuration (Used as Celery Broker and for Caching)
# REDIS_HOST: The hostname or IP address of the Redis server
REDIS_HOST=localhost
# REDIS_PORT: The port number of the Redis server
REDIS_PORT=6379
# REDIS_DB: The Redis database index (default: 0)
REDIS_DB=0

# External Service URLs
# JOB_MANAGER_URL: The base URL of the External Job Manager (or Dummy Manager for testing)
JOB_MANAGER_URL=http://localhost:9000

# Application Security and Logging
# LOG_LEVEL: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# SECRET_KEY: Secret key used for cryptographic signing (e.g., JWT)
SECRET_KEY=changethis

# CORS Settings
# BACKEND_CORS_ORIGINS: JSON list of allowed origins for CORS
BACKEND_CORS_ORIGINS=["*"]

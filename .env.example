# Application Settings
APP_NAME=graph-viz
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Server Settings
HOST=0.0.0.0
PORT=5003
WORKERS=4

# Database Settings (using SQLite for development)
DATABASE_URL=sqlite:///./graph_viz.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Job Manager API
JOB_MANAGER_URL=http://localhost:9000

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:5003", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/static/

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=false

# SSE / Polling
SSE_BUFFER_SIZE=512
EVENT_POLL_INTERVAL_MS=15000

# Authentication
REQUIRE_AUTHENTICATION=true

# OIDC Authentication
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=530427967867-jgqptp874gs6iao8tv910ab3m96c18ns.apps.googleusercontent.com
OIDC_CLIENT_SECRET=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
OIDC_REDIRECT_URI=http://localhost:5003/lineage-manager/authorized
OIDC_AUDIENCE=
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_SCOPES=["openid","email","profile"]

 

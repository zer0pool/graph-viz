# Application Settings
APP_APP_NAME=graph-viz
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-here

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=5003
APP_WORKERS=4

# Database Settings
DB_DRIVER=mysql+pymysql
DB_HOST=172.17.0.1
DB_PORT=33306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=lineage_manager
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# External Services
APP_JOB_MANAGER_URL=http://localhost:9000

# Static Files
APP_STATIC_URL=/static/
APP_STATIC_ROOT=/app/static/

# Logging
APP_LOG_LEVEL=DEBUG

# CORS Settings
CORS_ALLOWED_ORIGINS=["http://localhost:5003","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20
RATE_LIMIT_ENABLED=true

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false
REDIS_DEFAULT_TTL=60

# SSE Settings
SSE_BUFFER_SIZE=256
SSE_EVENT_POLL_INTERVAL_MS=15000

# Feature Flags
FEATURE_ENABLE_SWAGGER=true
FEATURE_ENABLE_METRICS=false
FEATURE_REQUIRE_AUTHENTICATION=true
FEATURE_ENABLE_BIGQUERY=true
FEATURE_BIGQUERY_HISTORY_TABLE=test_proeject.test_data.table_load_history
FEATURE_ENABLE_AUDIT_LOGGING=true
FEATURE_ENABLE_RATE_LIMITING=true

# BigQuery Settings
BIGQUERY_ENAGLE=false
BIGQUERY_HISTORY_TABLE_NAME=""

# OIDC Authentication
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:5003/lineage-manager/authorized
OIDC_AUDIENCE=
OIDC_JWKS_CACHE_SECONDS=3600
OIDC_SCOPES=["openid","email","profile"]

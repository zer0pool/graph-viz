# Application Settings
APP_NAME=graph-viz
ENVIRONMENT=development  # development, production
DEBUG=True
SECRET_KEY=your-secret-key-here

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4  # Number of Uvicorn workers for production

# CORS Settings
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Database Settings (if needed in future)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=graphviz
# DB_USER=postgres
# DB_PASSWORD=your-password

# Redis Settings (if needed for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Security Settings
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_PER_SECOND=10  # Number of requests allowed per second
RATE_LIMIT_BURST=20       # Maximum burst size

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/static/

# Feature Flags
ENABLE_SWAGGER=True       # Enable/Disable Swagger UI
ENABLE_METRICS=False      # Enable/Disable Prometheus metrics